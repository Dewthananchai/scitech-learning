# Supabase — คัดลอกไฟล์นี้เป็น .env.local (สำหรับรันเครื่อง)
# และใส่ค่าเดียวกันใน Vercel → Settings → Environment Variables (สำหรับ deploy)
# ค่าทั้งหมดหาได้ที่ supabase.com → โปรเจกต์ของคุณ → Project Settings → API

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
